# اختر مزود الذكاء الاصطناعي: "google" أو "openai"
AI_PROVIDER=google

# مفتاح Google Gemini API (عند استخدام @google/genai)
# احصل عليه من: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# مفتاح OpenAI API (عند استخدام openai)
# احصل عليه من: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# نموذج الذكاء الاصطناعي المستخدم
# لـ Google: gemini-flash-latest, gemini-flash-lite-latest, gemini-2.5-flash
# لـ OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
AI_MODEL=gemini-flash-lite-latest
# AI_MODEL=gpt-4o-mini

# ── إعدادات سيرفر واتساب Webhook ──
PORT=3000
WEBHOOK_VERIFY_TOKEN=my_secret_token
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_ID=your_phone_number_id

# ── الدفع: محافظ/CliQ + إيصال حصراً (لا بوابات إلكترونية ولا روابط دفع) ──
# التأكيد عبر تحقق الإيصال الآلي أو تأكيد الموظف من /admin
PUBLIC_BASE_URL=https://wasl-command-center.onrender.com

# ── CRM خارجي (اختياري — Google Sheets عبر Make/n8n) ──
# ضع رابط Webhook يستقبل POST JSON لكل حدث (message/order/booking/...)
CRM_WEBHOOK_URL=

# ── التذكير التلقائي (دقائق) ──
REMIND_EVERY_MS=300000
REMIND_AFTER_MIN=60
CART_AFTER_MIN=60

# ── حماية لوحة /admin (مهم للإنتاج!) ──
ADMIN_USER=admin
ADMIN_PASS=change_me_strong_password

# ── قنوات وصل: ماسنجر + انستغرام (توكن عام للتطوير فقط) ──
# الإنتاج: كل بوت له توكنه الخاص مشفراً ببياناته
# (features.messengerToken / features.instagramToken + features.messengerPageId / features.instagramId)
MESSENGER_PAGE_TOKEN=
INSTAGRAM_PAGE_TOKEN=

# ── توقيع Webhook من Meta (App Settings → Basic → App Secret) ──
# بدونه تُرفض كل Webhooks في الإنتاج — اتركه فارغاً للتطوير المحلي فقط
META_APP_SECRET=

# ── Embedded Signup: ربط العميل برقمه بنفسه (دقيقتان بدل ساعتين) ──
# من لوحة Meta: App ID + كونفج Facebook Login for Business (مسار الترحيل الكامل)
META_APP_ID=
META_EMBEDDED_CONFIG_ID=
# كونفج ثانٍ لمسار التعايش (Coexistence: الرقم يبقى على تطبيق العميل) —
# يُنشأ من القالب Create from template بنفس الصلاحيات. فارغ = زر التعايش معطل برسالة.
META_EMBEDDED_CONFIG_ID_COEX=

# ── مخرج طوارئ رقم مشترك (مؤقت فقط!) ──
# القاعدة: رقم واحد لكل بوت. إذا وُجد رقم على بوتين (وضع قائم)، حدد id المالك
# هنا ليعمل مؤقتاً مع تحذير عالٍ — ثم افصل الأرقام واحذف هذا السطر. فارغ = رفض صارم.
SHARED_NUMBER_TENANT_ID=

# ── الطابور (بدون Redis — داخلي، يُستبدل بـ BullMQ عند الحمل) ──
QUEUE_CONCURRENCY=5
QUEUE_RETRIES=2
QUEUE_TIMEOUT_MS=60000
# سقف الطابور الداخلي لمنع OOM بالفيض — الزائد يُسقط مع DLQ بدل الانهيار
QUEUE_MAX_QUEUED=500

# ── توقيع جلسات العملاء (JWT) ──
JWT_SECRET=change_me_long_random_string

# ── P2 SaaS: تشفير توكنات واتساب لكل بوت (AES-256-GCM) ──
# ولّد واحداً بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# ── الفويس نوت ──
VOICE_TIMEOUT_MS=15000
VOICE_MAX_MB=8
# P1: طابور الفويس المخصص (تزامن منخفض) + مهلة التفريغ
VOICE_QUEUE_CONCURRENCY=2
VOICE_TRANSCRIBE_TIMEOUT_MS=45000

# ── P1: طوابير دائمة (اختياري — بدونها يعمل وضع الذاكرة) ──
# فعّل بـ: npm i bullmq ioredis  ثم ضع رابط Redis هنا
REDIS_URL=
USE_DURABLE_QUEUE=1

# ── P1: الإرسال الصادر (إعادة + DLQ) ──
OUTBOUND_MAX_RETRIES=3
OUTBOUND_BASE_DELAY_MS=1000
OUTBOUND_TIMEOUT_MS=15000

# ── P1: طاقم العمل والقوالب ──
# رقم الموظف العام (يُتجاوزه tenant.features.staffPhone لكل بوت)
STAFF_PHONE=
WA_TEMPLATE_LANG=ar
# اسم قالب المتابعة المعتمد من Meta (يُستخدم خارج نافذة 24h) — فارغ = إشعار الموظف فقط
# خطوات الاعتماد: Meta Business Suite → Account Tools → Message Templates (قالب "خدمة عملاء/متابعة")
# → عدّل نصه ليشمل اسم البوت، ثم ضع اسمه هنا: NAME@LANG_CODE (مثال: wasl_followup@ar)
WA_FOLLOWUP_TEMPLATE=

# ── قاعدة البيانات PostgreSQL (اختياري — بدونها يعمل JSON محلي) ──
# أنشئ مشروعاً مجانياً في https://supabase.com ثم ضع رابط الاتصال هنا
# مثال: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=
